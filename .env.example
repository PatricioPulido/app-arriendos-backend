# Copia este archivo a .env (que NO se sube a git) y completa los valores.

# --- Base de datos ---
# Local (docker compose): deja DB_URL y DB_USERNAME asi y elige una DB_PASSWORD.
DB_URL=jdbc:postgresql://localhost:5432/arriendos
DB_USERNAME=arriendos
DB_PASSWORD=
# Supabase: ver docs/DESPLIEGUE.md (usar el "Session pooler", puerto 5432, con sslmode=require)
# DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.<id-de-tu-proyecto>

# Solo en desarrollo
SWAGGER_ENABLED=true
EXPOSE_ERROR_DETAILS=true

CORS_ALLOWED_ORIGINS=http://localhost:3000

# En http://localhost puedes dejarlo en true; en otro host sin HTTPS usa false
AUTH_COOKIE_SECURE=true

# Login: clave de firma de tokens (openssl rand -base64 48)
JWT_SECRET=

# Primer administrador (minimo 12 caracteres). Se crea al arrancar si no hay ninguno.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Copia este archivo a .env (que NO se sube a git) y completa los valores.

# Contrasena del usuario SYS/SYSTEM del contenedor Oracle
ORACLE_PASSWORD=

# Usuario de la aplicacion
DB_URL=jdbc:oracle:thin:@//localhost:1521/XE
DB_USERNAME=PATO
DB_PASSWORD=
DB_SCHEMA=PATO

# Solo en desarrollo
SWAGGER_ENABLED=true
EXPOSE_ERROR_DETAILS=true

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Login: clave de firma de tokens (openssl rand -base64 48)
JWT_SECRET=

# Primer administrador (minimo 12 caracteres). Se crea al arrancar si no hay ninguno.
ADMIN_EMAIL=
ADMIN_PASSWORD=
